    {
      "parameters": {
        "jsCode": "const text = $json.text || '';\nconst trimmed = text.trim();\n\n// Check 1: একেবারে খালি বা খুব ছোট\nconst tooShort = trimmed.length < 30;\n\n// Check 2: Readable character ratio (garbage/broken encoding হলে এখানে ধরা পড়বে)\nconst alphaNumeric = (trimmed.match(/[a-zA-Z0-9]/g) || []).length;\nconst readableRatio = trimmed.length > 0 ? alphaNumeric / trimmed.length : 0;\nconst looksGarbled = readableRatio < 0.3;\n\n// Check 3: Expected keyword presence (invoice হলে এই ধরনের word থাকারই কথা)\nconst expectedKeywords = ['invoice', 'amount', 'total', 'date', 'bill'];\nconst hasExpectedKeyword = expectedKeywords.some(k => \n  trimmed.toLowerCase().includes(k)\n);\n\n// Check 4: Repeated/looping garbage pattern (কিছু bad PDF extract এ একই character বারবার আসে)\nconst suspiciousRepeat = /(.)\\1{20,}/.test(trimmed);\n\n// Final decision\nconst needsVisionFallback = tooShort || looksGarbled || suspiciousRepeat || !hasExpectedKeyword;\n\nreturn {\n  json: {\n    ...$json,\n    extraction_confidence: needsVisionFallback ? 'low' : 'high',\n    needs_vision_fallback: needsVisionFallback,\n    debug_reason: tooShort ? 'too_short' : looksGarbled ? 'garbled' : suspiciousRepeat ? 'repeated_chars' : !hasExpectedKeyword ? 'no_keywords' : 'ok'\n  }\n};"
      },
